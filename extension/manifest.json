{
  "manifest_version": 3,
  "name": "Skiper",
  "description": "Filters YouTube recommendations by transcript quality and personal relevance.",
  "version": "0.1.0",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://api.skiper.stefanov.tech/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "pages/popup.html",
    "default_title": "Skiper"
  },
  "options_page": "pages/options.html",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ]
}
